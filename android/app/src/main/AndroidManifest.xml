<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Lets StageMon show up in "Open with"/"Complete action using" for
                 .stagemonlayout files shared from other apps (WhatsApp, email,
                 Drive, a file manager...).

                 content:// (WhatsApp, email, Drive...) matches
                 mimeType="application/octet-stream" — the generic type apps
                 like WhatsApp assign to an extension Android doesn't
                 recognize. Confirmed on-device that content:// URIs from
                 these apps don't preserve the filename anywhere in the URI
                 (opaque IDs — by design, that's the whole point of the
                 Storage Access Framework), so pathPattern can't discriminate
                 here; matching by type is the only option. Deliberately NOT
                 "*/*": the phone's own file explorer (MediaStore) sends VIEW
                 intents for unrecognized extensions with no type at all,
                 which "*/*" would also catch, making StageMon open directly
                 (no chooser, since nothing else claims it) for literally any
                 unrelated file — confirmed by comparing real installed apps
                 with the same custom-extension need (checked via `adb shell
                 dumpsys package <pkg>`): all of them scope content:// to
                 application/octet-stream specifically, and none of them
                 open from the file explorer either — this is the normal,
                 expected trade-off, not something to work around. Anything
                 StageMon can't parse as a layout gets rejected by
                 _applyImportedContent's own validation in
                 layouts_screen.dart, same as manual file-picker import.

                 file:// URIs are the real filesystem path, so pathPattern
                 does work there and narrows it to our own files.

                 content and file are two SEPARATE <intent-filter> blocks, not
                 two <data> tags in one: <data> tags within a single filter
                 get merged into one shared set of paths/types, so file's
                 pathPattern would also end up required for content — which
                 defeats the point (confirmed on-device: WhatsApp stopped
                 matching once that happened). Separate intent-filter blocks
                 stay fully independent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="content"
                    android:host="*"
                    android:mimeType="application/octet-stream"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="file"
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern=".*\\.stagemonlayout"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
